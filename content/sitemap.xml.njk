---
permalink: /sitemap.xml
layout: false
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for entry in collections.all %}
	{%- if entry.data.permalink != false %}
	<url>
		<loc>{{ entry.url | htmlBaseUrl(metadata.url) }}</loc>
		<lastmod>{{ (entry.data.updated if entry.data.updated | isLaterDay(entry.date) else entry.date) | htmlDateString }}</lastmod>
	</url>
	{%- endif %}
{%- endfor %}
</urlset>
