---js
const layout = "layouts/base.njk";
---
{#- The tagline is this page's h1, in the header (base.njk). The full,
    year-grouped list is /blog/. #}
<section class="year latest" aria-labelledby="latest">
	<h2 id="latest">Latest</h2>
	<ul class="posts">
	{%- for row in collections.posts | latestRows(metadata.latest) %}
		<li{% if row.child %} class="child"{% endif %}><time datetime="{{ row.post.date | htmlDateString }}">{{ row.post.date | htmlDateString }}</time><a href="{{ row.post.url }}">{{ row.post.data.title }}</a><span class="topics">{% for topic in row.post.data.tags %}{% if topic != "posts" %}<a href="/tags/{{ topic | slugify }}/">{{ topic }}</a>{% endif %}{% endfor %}</span></li>
	{%- endfor %}
	</ul>
</section>
<p class="more"><a href="/blog/">All {{ collections.posts | length }} posts →</a></p>
