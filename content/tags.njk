---js
const layout = "layouts/base.njk";
const permalink = "/tags/";
const title = "Tags";
const description = "Topics on the blog.";
---
<h1>Tags</h1>
<ul class="tags">
{%- for topic in collections | topicList %}
	<li><a href="/tags/{{ topic | slugify }}/">{{ topic }}</a><span class="count">{{ collections[topic] | length }}</span></li>
{%- endfor %}
</ul>
