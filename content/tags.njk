---js
const layout = "layouts/base.njk";
const permalink = "/tags/";
const title = "Tags";
const description = "Topics on the blog.";
---
<h1>Tags</h1>
{%- set topics = collections | topicList %}
{%- if topics.length %}
<ul class="tags">
{%- for topic in topics %}
	<li><a href="/tags/{{ topic | slugify }}/">{{ topic }}</a></li>
{%- endfor %}
</ul>
{%- else %}
<p class="empty">No tags yet.</p>
{%- endif %}
