{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "_site",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/blog/page/:match*",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/feed",
      "destination": "/feed.xml",
      "permanent": true
    },
    {
      "source": "/feed/",
      "destination": "/feed.xml",
      "permanent": true
    },
    {
      "source": "/feed/feed.xml",
      "destination": "/feed.xml",
      "permanent": true
    }
  ]
}
