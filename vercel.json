{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "_site",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/blog/page/:n/",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/tags/photography/",
      "destination": "/tags/storytelling/",
      "permanent": true
    }
  ]
}
