{%- for group in postslist | byYear %}
<section class="year" aria-labelledby="y{{ group.year }}">
	<h2 id="y{{ group.year }}">{{ group.year }}</h2>
	<ul class="posts">
	{%- for row in group.rows %}
		<li{% if row.child %} class="child"{% endif %}><time datetime="{{ row.post.date | htmlDateString }}">{{ row.post.date | listDate }}</time><a href="{{ row.post.url }}">{{ row.post.data.title }}</a><span class="topics">{% for topic in row.post.data.tags %}{% if topic != "posts" %}<a href="/tags/{{ topic | slugify }}/">{{ topic }}</a>{% endif %}{% endfor %}</span></li>
	{%- endfor %}
	</ul>
</section>
{%- endfor %}
