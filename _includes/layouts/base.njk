<!doctype html>
<html lang="{{ metadata.language }}">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>{% if title and page.url != "/" %}{{ title }} · {{ metadata.title }}{% else %}{{ metadata.title }} · {{ metadata.headerTitle }}{% endif %}</title>
		<meta name="description" content="{{ description or metadata.description }}">
		{%- if page.url %}
		<link rel="canonical" href="{{ page.url | htmlBaseUrl(metadata.url) }}">
		{%- endif %}
		<link rel="alternate" href="/feed.xml" type="application/atom+xml" title="{{ metadata.title }}">
		<meta name="color-scheme" content="light dark">
		<style>{% include "css/index.css" %}</style>
	</head>
	<body>
		<a href="#main" class="skip-link">skip to content</a>
		{%- set home = page.url == "/" %}
		<header>
			<a class="brand" href="/"{% if home %} aria-current="page"{% endif %}><img src="/static/logo.svg" alt="" width="30" height="30">{{ metadata.headerTitle }}</a>
			{%- if home %}
			<h1 class="tagline">{{ metadata.description }}</h1>
			{%- else %}
			<p class="tagline">{{ metadata.description }}</p>
			{%- endif %}
			<nav aria-label="Site">
				<ul>
				{%- for item in metadata.nav %}
					<li><a href="{{ item.url }}"{% if page.url == item.url or (item.url == "/blog/" and page.url.startsWith("/blog/")) or (item.url == "/tags/" and page.url.startsWith("/tags/")) %} aria-current="{{ 'page' if page.url == item.url else 'true' }}"{% endif %}>{{ item.title }}</a></li>
				{%- endfor %}
				</ul>
			</nav>
		</header>

		<main id="main" tabindex="-1">
			{{ content | safe }}
		</main>

		<footer>
			<span>© {{ metadata.year }} {{ metadata.headerTitle }}</span>
			<span><a href="/feed.xml" type="application/atom+xml">feed.xml</a> · <a href="{{ metadata.github }}">github</a> · <a href="mailto:{{ metadata.email }}">email</a></span>
		</footer>
	</body>
</html>
