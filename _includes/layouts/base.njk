<!doctype html>
<html lang="{{ metadata.language }}">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>{% if title and page.url != "/" %}{{ title }} · {{ metadata.title }}{% else %}{{ metadata.title }} · {{ metadata.headerTitle }}{% endif %}</title>
		<meta name="description" content="{{ description or metadata.description }}">
		{%- if page.url %}
		<link rel="canonical" href="{{ page.url | htmlBaseUrl(metadata.url) }}">
		{%- endif %}
		<link rel="alternate" href="/feed.xml" type="application/atom+xml" title="{{ metadata.title }}">
		<meta name="color-scheme" content="light dark">
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
		<meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)">
		<link rel="icon" href="/favicon.ico">
		<link rel="icon" href="/static/favicons/favicon-32x32.png" type="image/png">
		<link rel="apple-touch-icon" href="/static/favicons/apple-touch-icon.png">

		<style>{% include "css/index.css" %}</style>
		<style>{% getBundle "css" %}</style>
	</head>
	<body>
		<a href="#main" class="skip-link">skip to content</a>
		{%- set home = page.url == "/" %}
		<header>
		{%- if home %}
			<p class="site"><a href="/" aria-current="page">{{ metadata.headerTitle }}</a></p>
			<h1 class="tagline">{{ metadata.description }}</h1>
			<nav aria-label="Site">
				<ul>
					<li><a href="/blog/">Blog</a></li>
					<li><a href="/tags/">Tags</a></li>
					<li><a href="/about/">About</a></li>
					<li><a href="/feed.xml" type="application/atom+xml">RSS</a></li>
				</ul>
			</nav>
		{%- else %}
			<p class="site"><a href="/">{{ metadata.headerTitle }}</a></p>
			<nav aria-label="Site">
				<ul>
					<li><a href="/blog/"{% if page.url == "/blog/" %} aria-current="page"{% endif %}>Blog</a></li>
					<li><a href="/tags/"{% if page.url == "/tags/" %} aria-current="page"{% endif %}>Tags</a></li>
					<li><a href="/about/"{% if page.url == "/about/" %} aria-current="page"{% endif %}>About</a></li>
					<li><a href="/feed.xml" type="application/atom+xml">RSS</a></li>
				</ul>
			</nav>
		{%- endif %}
		</header>

		<main id="main" tabindex="-1">
			{{ content | safe }}
		</main>

		<footer><a href="mailto:{{ metadata.email }}" aria-label="email"><svg class="icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></a> · <a href="/feed.xml" type="application/atom+xml">rss</a></footer>
	</body>
</html>
